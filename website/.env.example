# =============================================================
# DTWS Public Website — Environment Template
# Copy this file to `website/.env.local` and fill in values.
# These variables ARE safe for the public browser (NEXT_PUBLIC_*).
# Do NOT add any secret keys, API tokens, or admin credentials here.
# Server-only secrets for the website's public write APIs (if any)
# live in the Optimus template or are provided by the backend.
# =============================================================

# ---------------- Public origins ----------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_OPTIMUS_URL=http://localhost:3001

# ---------------- Firebase client (public, safe for browser) ----------------
# Values from Firebase Console → Project settings → General → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
