# =============================================================
# Optimus — Private DemiTech Portal — Environment Template
# Copy this file to `optimus/.env.local` and fill in values.
#
# RULES
#   - All variables in this file (even NEXT_PUBLIC_*) are for the
#     Optimus application ONLY. The public website must never read
#     or inherit the private vars listed below.
#   - Secrets (LLM_API_KEY, TELNYX_*, BREVO_*, FIREBASE_ADMIN_*,
#     CRON_SECRET, WEBHOOK_HMAC_SECRET, CSRF_SECRET, SESSION_SECRET)
#     MUST remain server-only.
#   - NEVER commit `.env.local` or paste secrets into this template.
# =============================================================

# ---------------- Public origins (Optimus-only) ----------------
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_OPTIMUS_URL=http://localhost:3001

# ---------------- Firebase client (safe for Optimus browser) ----------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------- Firebase Admin (Server — SECRET) ----------------
# Option A (preferred): paste full JSON of service account key
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual fields (used if FIREBASE_SERVICE_ACCOUNT_JSON is empty)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------- AI / LLM (Server — SECRET) ----------------
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------------- Email provider — Brevo (Server — SECRET) ----------------
BREVO_API_KEY=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=
BREVO_WEBHOOK_SECRET=

# ---------------- Voice — Telnyx (Server — SECRET) ----------------
TELNYX_API_KEY=
TELNYX_PROFILE_ID=
TELNYX_CALLER_ID=
TEBOGO_PHONE_E164=
TELNYX_WEBHOOK_SECRET=

# ---------------- Optional: ElevenLabs TTS (Server) ----------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------- WhatsApp (Server — SECRET) ----------------
WHATSAPP_PROVIDER=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ---------------- System (Server — SECRET) ----------------
CRON_SECRET=
WEBHOOK_HMAC_SECRET=
CSRF_SECRET=
SESSION_SECRET=
OPTIMUS_INTERNAL_API_HMAC_SECRET=

# ---------------- Default budget limits (Server) ----------------
BUDGET_AI_LIMIT_USD=
BUDGET_EMAIL_LIMIT_USD=
BUDGET_VOICE_LIMIT_USD=
BUDGET_WHATSAPP_LIMIT_USD=
BUDGET_TOTAL_LIMIT_USD=
DAILY_MAX_EMAILS=
DAILY_MAX_CALLS_MINUTES=
DAILY_MAX_WHATSAPP=
